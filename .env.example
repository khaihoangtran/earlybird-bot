# --- Work Portal Credentials ---
PORTAL_URL=https://your-work-portal.example.com/login
# Page to navigate to after login where the check-in/out button lives.
# Optional - defaults to PORTAL_URL if left blank (e.g. login lands directly there).
PORTAL_CHECK_URL=https://your-work-portal.example.com/attendance
PORTAL_USER=your_portal_username
PORTAL_PASS=your_portal_password

# --- Telegram Bot ---
# Obtain from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=123456789:ABCDefGhIJKlmNoPQRsTUVwxyZ
# Your personal Telegram numeric chat/user ID (use @userinfobot to find it)
CHAT_ID=123456789

# --- Server ---
# Render provides $PORT automatically; default used for local runs
PORT=10000

# --- Optional ---
# IANA timezone used for scheduling and working-day checks
TIMEZONE=Asia/Ho_Chi_Minh

# --- Scheduling (optional; defaults shown) ---
# Check-in fires at CHECKIN_WINDOW_START_* every day, then waits a random
# delay so the actual punch happens randomly before CHECKIN_DEADLINE_* (e.g.
# somewhere between 08:00 and 08:30), instead of always at a fixed time.
CHECKIN_WINDOW_START_HOUR=8
CHECKIN_WINDOW_START_MINUTE=0
CHECKIN_DEADLINE_HOUR=8
CHECKIN_DEADLINE_MINUTE=30
# Check-out fires at a fixed time, then waits a random 1-10 minutes after.
CHECKOUT_HOUR=17
CHECKOUT_MINUTE=30
